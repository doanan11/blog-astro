---
import { NAV } from '../consts';
import { withBase } from '../lib/url';

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return path === '/' || path === '';
  return path.startsWith(href);
}
---

<nav class="site-nav">
  {
    NAV.map((item) => (
      <a href={withBase(item.href)} class:list={['nav-link', { active: isActive(item.href) }]}>
        {item.label}
      </a>
    ))
  }
  <a class="nav-link" href={withBase('/rss.xml')}>RSS</a>
  <button class="theme-toggle" type="button" aria-label="切换深浅色" data-theme-toggle>
    <span class="theme-icon">◐</span>
  </button>
</nav>

<script>
  const toggle = document.querySelector('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
